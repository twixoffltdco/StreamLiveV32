# StreamLive — корневой .htaccess
# Красивые ссылки без .php на ВСЕХ страницах проекта + базовая защита служебных папок.
# Антидудос/антибот (рейт-лимит, капча, JS-проверка при всплеске трафика) живёт в PHP
# (includes/antibot.php, подключается из includes/functions.php на каждый запрос) —
# на бесплатном Apache-хостинге нет доступа к mod_evasive/mod_security, поэтому вся
# логика лимитов сделана на уровне приложения, а не здесь.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # ---- 1) Точечные "человеческие" маршруты для страниц с параметром в URL ----
  # /video/nazvanie-slug     → video.php?slug=nazvanie-slug
  RewriteRule ^video/([a-zA-Z0-9_-]+)/?$ video.php?slug=$1 [L,QSA]

  # /channel/nazvanie-slug   → channel.php?slug=nazvanie-slug
  RewriteRule ^channel/([a-zA-Z0-9_-]+)/?$ channel.php?slug=$1 [L,QSA]

  # short links
  RewriteRule ^g/([a-zA-Z0-9]+)/?$ g.php?c=$1 [L,QSA]

  # /s/nazvanie-slug         → s.php?slug=nazvanie-slug (задеплоенные GitHub-сервисы)
  RewriteRule ^s/([a-zA-Z0-9_-]+)/?$ s.php?slug=$1 [L,QSA]

  # /u/username              → profile.php?username=username
  RewriteRule ^u/([a-zA-Z0-9_-]+)/?$ profile.php?username=$1 [L,QSA]

  # ---- 2) Общее правило для всех остальных страниц: /forum → forum.php, /videos → videos.php,
  # /rating → rating.php и так далее — работает сразу для ЛЮБОГО .php-файла в корне проекта,
  # включая те, что появятся в будущем, без необходимости дописывать сюда новую строку
  # на каждую новую страницу.
  #
  # Условия защищают от неправильного срабатывания:
  #   - !-f и !-d — если по такому пути реально существует файл или папка (assets/, storage/,
  #     admin/, картинка, css) — правило вообще не трогает запрос, отдаётся как есть;
  #   - третье условие проверяет, что рядом реально лежит файл с расширением .php — иначе
  #     обычный 404 на несуществующую страницу останется обычным 404, а не подключит что попало.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.php -f
  RewriteRule ^([a-zA-Z0-9_\-/]+)/?$ $1.php [L,QSA]

  # ---- 3) Если где-то на сайте (старая ссылка, закладка) открыли явный .php-адрес —
  # незаметно для пользователя редиректим на красивый вариант, чтобы в адресной строке
  # .php не светился нигде. Только для GET/HEAD — POST-формы и fetch()-запросы (лайки,
  # избранное, чат, комментарии и т.д.) НЕ трогаем: 301 на POST ломает отправку форм,
  # браузер обязан повторить её как GET, а бэкенд ждёт именно POST.
  RewriteCond %{REQUEST_METHOD} GET [OR]
  RewriteCond %{REQUEST_METHOD} HEAD
  RewriteCond %{THE_REQUEST} \s/+([a-zA-Z0-9_\-/]+)\.php[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]
</IfModule>

# ---- Служебные папки — закрываем прямой доступ из браузера ----
# includes/*.php не предназначены для прямого открытия (только через require из других
# файлов), а sql/*.sql — вообще не PHP и без этой защиты отдались бы как обычный текст,
# раскрывая структуру базы. services_data/ НЕ трогаем — там лежат опубликованные through
# /s/ сервисы пользователей, они должны открываться напрямую.
<IfModule mod_authz_core.c>
  <FilesMatch "\.(sql|log|env)$">
    Require all denied
  </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
  <FilesMatch "\.(sql|log|env)$">
    Order allow,deny
    Deny from all
  </FilesMatch>
</IfModule>

RewriteEngine On
RewriteRule ^includes/ - [F,L]
RewriteRule ^config/ - [F,L]
RewriteRule ^sql/ - [F,L]

# Запрещаем листинг содержимого папок без index-файла
Options -Indexes

# === StreamLive: троттлинг на shared Apache (InfinityFree / freedev) ===
# Вставить в КОРНЕВОЙ .htaccess ПОСЛЕ RewriteEngine On / основных rewrite.
# На части хостов mod_ratelimit / mod_reqtimeout нет — тогда сработает только PHP poll_throttle.

# Не отдавать листинг
Options -Indexes

# Таймаут долгих запросов (если модуль есть)
<IfModule mod_reqtimeout.c>
  RequestReadTimeout header=10 body=20
</IfModule>

# Ограничение скорости отдачи тяжёлым клиентам (если модуль есть)
<IfModule mod_ratelimit.c>
  <LocationMatch "(message_poll|api_notifications_poll|chat_poll|comments_poll|forum_poll|watch_room_poll|watch_room_chat_poll)">
    SetOutputFilter RATE_LIMIT
    SetEnv rate-limit 200
  </LocationMatch>
</IfModule>

# Кеш статики — меньше hits на PHP
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|png|jpg|jpeg|gif|webp|svg|woff2)$">
    Header set Cache-Control "public, max-age=604800, immutable"
  </FilesMatch>
</IfModule>

